TELEGRAM_BOT_TOKEN=your_token
OPENROUTER_API_KEY=your_key

CEO_MODEL=google/gemini-3.1-flash-lite
CEO_MODEL_REASONING=true

CRO_MODEL=google/gemini-3.1-flash-lite
CRO_MODEL_REASONING=true

NEWS_ANALYST_MODEL=openai/gpt-4o-mini
NEWS_ANALYST_MODEL_REASONING=false

POSTGRES_URL=postgresql://user:password@localhost:5432/arena_db
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

FINANCE_FETCH_DELAY_SECONDS=1.5
RESEARCH_FETCH_DELAY_SECONDS=1.5
DEBUG_PROMPTS=false
SHOW_AI_DATA=false

# Output language: en (English) or th (Thai)
OUTPUT_LANGUAGE=en

# SEC EDGAR identity (required for edgartools)
EDGAR_IDENTITY=your-app-name your@email.com

# Tavily Advanced Search (optional)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# ADVANCED_SEARCH=false
# TAVILY_SEARCH_DEPTH=fast
# TAVILY_MAX_RESULTS=5

# Investment style: swing_trader or deep_value_vi
# INVESTMENT_STYLE=swing_trader

# --- Technical indicator thresholds (indicator_math.py) ---
# RSI_OVERBOUGHT=70.0
# RSI_OVERSOLD=30.0
# MFI_OVERBOUGHT=80.0
# MFI_OVERSOLD=20.0
# VOLUME_TREND_BULLISH_MULTIPLIER=1.25
# VOLUME_TREND_BEARISH_MULTIPLIER=0.75
# BOLLINGER_SQUEEZE_QUANTILE=0.2
# BOLLINGER_LOW_QUANTILE=0.35
# BOLLINGER_HIGH_QUANTILE=0.8
# RS_WEIGHT_3M=0.4
# RS_WEIGHT_6M=0.2
# RS_WEIGHT_9M=0.2
# RS_WEIGHT_12M=0.2
# SUPERTREND_ATR_PERIOD=10
# SUPERTREND_MULTIPLIER=3.0

# --- Fundamental thresholds (indicator_math.py) ---
# PIOTROSKI_STRONG_THRESHOLD=7
# PIOTROSKI_WEAK_THRESHOLD=3
# PEG_CHEAP_THRESHOLD=1.0
# PEG_EXPENSIVE_THRESHOLD=2.0
# ALTMAN_SAFE_THRESHOLD=3.0
# ALTMAN_DISTRESS_THRESHOLD=1.8
# ALTMAN_BUCKET_HIGH=3.0
# ALTMAN_BUCKET_MID=2.0
# ALTMAN_BUCKET_LOW=1.0
# PEG_REGIME_CHEAP=0.8
# PEG_REGIME_REASONABLE=1.5
# ALTMAN_INSOLVENCY_THRESHOLD=1.0

# --- Adaptive threshold mode (opt-in; default off = fixed thresholds above) ---
# ADAPTIVE_THRESHOLDS=false
# ADAPTIVE_LOOKBACK=252
# ADAPTIVE_PERCENTILE_OVERBOUGHT=0.9
# ADAPTIVE_PERCENTILE_OVERSOLD=0.1